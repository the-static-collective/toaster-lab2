{
  "name": "toast-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npm run test:product-contract && npm run test:bridge && npm run test:transfer && npm run test:lyrics",
    "test:bridge": "tsx scripts/prove-haunted-toaster-bridge.ts",
    "test:transfer": "tsx scripts/prove-proposal-transfer.ts",
    "test:consumer-transfer": "tsx scripts/prove-current-haunted-toaster-consumer.ts",
    "test:lyrics": "tsx scripts/prove-lyric-provenance.ts",
    "test:product-contract": "tsx scripts/prove-product-contract.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "haunted-toaster": "github:the-static-collective/the-haunted-toaster#v0.5.0-alpha.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
